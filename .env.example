APP_HOST=127.0.0.1
APP_PORT=3001
DATABASE_PATH=./runtime/app/app.sqlite
MODEL_PROTOCOL=chat_completions
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=120000
# Optional fixed clock for isolated data-test-* databases only. Normal runtime uses real time.
BUSINESS_CLOCK=

# Optional P11 paths. Defaults to the bundled Codex Artifact Tool runtime and materials beside DATABASE_PATH.
# ARTIFACT_MODULE_PATH=C:/path/to/@oai/artifact-tool/dist/artifact_tool.mjs
# MATERIAL_ROOT=./runtime/app/materials

# Exa public web search (server only)
EXA_API_KEY=
EXA_SEARCH_ENABLED=true

# Cloud pilot only: generate a random value of at least 20 characters; keep out of Git.
DEPLOYMENT_ACCESS_PASSWORD=
# Use libreoffice on a Linux host with LibreOffice Impress, Poppler and open fonts installed.
PRESENTATION_ENGINE=
PRESENTATION_FONT=Noto Sans CJK SC
